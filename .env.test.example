NODE_ENV=test

# Dedicated database URL for integration tests.
# You can point to the same local Docker DB as DATABASE_URL because tests isolate data by schema.
DATABASE_URL_TEST=postgresql://edutrack:edutrack@localhost:5432/edutrack

# JWT keys are still required by auth tests.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
