NODE_ENV=development
PORT=3000
# Niveau de logs Pino : trace | debug | info | warn | error (défaut: info)
LOG_LEVEL=info
DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/edutrack
# Optional but recommended for integration tests; falls back to DATABASE_URL if omitted.
DATABASE_URL_TEST=postgresql://edutrack:edutrack@localhost:5432/edutrack
REDIS_URL=redis://localhost:6379

# URL publique de l'API (utilisée dans la doc Swagger). Défaut: http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
# URL publique du frontend (liens dans les e-mails/SMS, ex. portail parent).
APP_BASE_URL=http://localhost:5173
# Expose Swagger UI hors production. En production, mettre à true pour l'activer (/docs).
ENABLE_SWAGGER=false
# Schéma tenant par défaut quand aucun en-tête x-tenant-schema n'est fourni (dev/démo).
AUTH_DEFAULT_TENANT_SCHEMA=school_sainte_marie

# JWT - store in a secret manager (Railway Secrets / Doppler / Vault) in production.
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out private.pem
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

AUTH_PROVIDER=local
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TENANT_CLAIM=schemaName
KEYCLOAK_REQUIRE_TENANT_CLAIM=false
AUTH_ALLOW_LEGACY_REFRESH=false

# === SMS Provider Configuration ===
# Africa's Talking (primary)
AFRICASTALKING_API_KEY=atsk_replace_me
AFRICASTALKING_USERNAME=edutrack_ci
AFRICASTALKING_SENDER_ID=EduTrack
AFRICASTALKING_BASE_URL=https://api.africastalking.com/version1/messaging

# smsmode (replaces Orange - reception is reliable)
SMSMODE_API_KEY=your-smsmode-api-key
SMSMODE_SENDER=EduTrack
SMSMODE_BASE_URL=https://rest.smsmode.com/sms/v1
SMS_MOCK=false

# === Email ===
EMAIL_PROVIDER=mock
EMAIL_MOCK=true
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=EduTrack <notifications@example.com>

# === Teachers / import defaults ===
# REQUIRED for teacher import; if absent, a random 10-char password is generated and logged.
IMPORT_TEACHER_DEFAULT_PASSWORD=

# === Payments ===
MTN_MOMO_API_KEY=your-mtn-momo-api-key
MTN_MOMO_ENV=sandbox

# === Object storage (Cloudflare R2 / S3 compatible) ===
# Documents administratifs (diplôme, CNI, contrat, photo, relevé) profs/élèves.
# Si ces variables sont vides, le stockage bascule automatiquement sur le disque local
# (voir DOCUMENTS_LOCAL_STORAGE_ROOT) - pratique en dev.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=edutrack-files
# Endpoint S3 du bucket R2 (ex. https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Répertoire local de secours pour les documents quand R2 n'est pas configuré.
DOCUMENTS_LOCAL_STORAGE_ROOT=.tmp/documents
# Répertoire de sortie des exports PDF de paie/relevés générés par les workers.
BILLING_EXPORT_DIR=/tmp/edutrack-exports

# === QR codes de pointage ===
# Base d'URL encodée dans les QR codes des salles (lien ouvert par le prof).
# Défaut: APP_BASE_URL. Ex. https://app.ivoiredu.ci
QR_SCAN_BASE_URL=http://localhost:5173

# === Observability ===
SENTRY_DSN=

# === CORS / Security ===
# REQUIRED in production. Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# REQUIRED. 32+ chars random secret used to sign salary export download URLs.
# Generate with: openssl rand -hex 32
SALARY_EXPORT_SIGNING_SECRET=

# Numero de secours si le directeur n'a pas de phone en DB (format 225 + 10 chiffres)
DEFAULT_SCHOOL_PHONE=
