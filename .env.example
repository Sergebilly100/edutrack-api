NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/edutrack
# Optional but recommended for integration tests; falls back to DATABASE_URL if omitted.
DATABASE_URL_TEST=postgresql://edutrack:edutrack@localhost:5432/edutrack
REDIS_URL=redis://localhost:6379
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_SENDER_ID=EduTrack
SMS_MOCK=true
IMPORT_TEACHER_DEFAULT_PASSWORD=edutrack2024
MTN_MOMO_API_KEY=your-mtn-momo-api-key
MTN_MOMO_ENV=sandbox
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=edutrack-files
SENTRY_DSN=your-sentry-dsn
# Numero de secours si le directeur n'a pas de phone en DB (format 225 + 10 chiffres)
DEFAULT_SCHOOL_PHONE=
