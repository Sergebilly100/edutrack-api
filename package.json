{
  "name": "edutrack-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:unit": "vitest tests/unit",
    "test:unit:t28": "vitest --run tests/unit/attendance.service.test.ts tests/unit/auth.service.test.ts tests/unit/notifications.service.test.ts tests/unit/shared/events/event-bus.test.ts",
    "test:unit:t28:coverage": "vitest --run --coverage tests/unit/attendance.service.test.ts tests/unit/auth.service.test.ts tests/unit/notifications.service.test.ts tests/unit/shared/events/event-bus.test.ts --coverage.include=src/modules/attendance/attendance.service.ts --coverage.include=src/modules/auth/auth.service.ts --coverage.include=src/modules/notifications/notifications.service.ts --coverage.include=src/shared/events/event-bus.ts",
    "test:integration": "vitest run --project=integration",
    "test:integration:a3": "vitest run tests/integration/permissions.routes.test.ts",
    "test:integration:a5": "vitest run tests/integration/admin.v3.routes.test.ts",
    "smoke:notifications": "tsx scripts/notification-smoke.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/shared/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "sync-types": "mkdir -p ../edutrack-web/src/shared/types && cp src/shared/types/index.ts ../edutrack-web/src/shared/types/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/etag": "^6.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@sentry/node": "^10.53.1",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.61.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.6",
    "eventemitter2": "^6.4.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.4",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^8.57.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
